#!/bin/sh
# Runs the real gh signed in as Milton's GitHub App. Installation tokens expire
# after an hour, so one is fetched per call (cached by the helper) instead of
# being exported once into the long-lived terminal shell.
# Flux substitutes braced variables in this file, so keep these unbraced.
if [ -z "$GH_TOKEN" ] && [ -r /opt/secrets/github-app/private-key.pem ]; then
  GH_TOKEN=$(python3 /opt/terminal/github_app_token.py) || exit 1
  export GH_TOKEN
fi
exec /opt/data/.local/bin/gh "$@"
