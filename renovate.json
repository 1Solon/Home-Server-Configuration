{
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":reviewer(1Solon)"
  ],
  "dependencyDashboard": true,
  "ignorePaths": ["archive/**"],
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "flux": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "helmfile": {
    "managerFilePatterns": ["/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "kustomize": {
    "managerFilePatterns": ["/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"]
  },
  "packageRules": [
    {
      "description": "CNPG PostgreSQL major upgrades require a planned database migration, not an unattended image rollout",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Jellyfin changed from three-part versions to two-part versions in 12.0; exclude floating, nightly, and platform tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["jellyfin/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    },
    {
      "description": "CoreDNS Group",
      "groupName": "CoreDNS",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/coredns/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Flux Operator Group",
      "groupName": "Flux Operator",
      "matchPackageNames": ["/flux-operator/", "/flux-instance/"],
      "matchDatasources": ["docker"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Spegel Group",
      "groupName": "Spegel",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/spegel/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Auto-merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat",
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}})!:",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )"
    },
    {
      "matchUpdateTypes": ["minor"],
      "semanticCommitType": "feat",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )"
    },
    {
      "matchUpdateTypes": ["patch"],
      "semanticCommitType": "fix",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )"
    },
    {
      "matchUpdateTypes": ["digest"],
      "semanticCommitType": "chore",
      "commitMessageExtra": "( {{currentDigestShort}} → {{newDigestShort}} )"
    },
    {
      "matchDatasources": ["docker"],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}"
    },
    {
      "matchDatasources": ["helm"],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchDatasources": ["github-releases"],
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["type/major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["type/minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["type/patch"]
    },
    {
      "matchDatasources": ["docker"],
      "addLabels": ["renovate/container"]
    },
    {
      "matchDatasources": ["helm"],
      "addLabels": ["renovate/helm"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["renovate/github-action"]
    },
    {
      "matchDatasources": ["github-releases"],
      "addLabels": ["renovate/github-release"]
    },
    {
      "description": "Talos Factory",
      "matchDatasources": ["custom.talos-factory"],
      "versioning": "semver-coerced",
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}",
      "addLabels": ["renovate/github-release"]
    }
  ],
  "customManagers": [
    {
      "description": "Track CNPG Cluster imageName fields missed by the Kubernetes manager",
      "customType": "regex",
      "managerFilePatterns": [
        "/^kubernetes/storage/databases/cloudnative-postgres/cluster/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]+imageName:[ \\t]+[\"']?(?<depName>[^\\s\"'@]+):(?<currentValue>[^\\s\"':@]+)(?:@(?<currentDigest>sha256:[a-fA-F0-9]{64}))?[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Process annotated dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
        "/^scripts/kopiur$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    }
  ],
  "customDatasources": {
    "talos-factory": {
      "defaultRegistryUrlTemplate": "https://factory.talos.dev/versions",
      "transformTemplates": [
        "{\"releases\": $map($, function($v) { {\"version\": $v, \"sourceUrl\": \"https://github.com/siderolabs/talos\", \"changelogUrl\": $join([\"https://github.com/siderolabs/talos/releases/tag/\", $v])} }), \"sourceUrl\": \"https://github.com/siderolabs/talos\", \"homepage\": \"https://factory.talos.dev\"}"
      ]
    }
  }
}
