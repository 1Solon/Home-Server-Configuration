#!/usr/bin/env bash
set -euo pipefail

# renovate: datasource=github-releases depName=home-operations/kopiur
version=0.10.8

case "$(uname -s)" in
  Darwin) os="darwin" ;;
  Linux) os="linux" ;;
  *) echo "unsupported operating system: $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch="arm64" ;;
  x86_64|amd64) arch="amd64" ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

case "${os}_${arch}" in
  darwin_amd64) checksum="af8edbb2fd9b6ad84f4aa4cb4f4ed7bce506b203c1f116bf00d81bf00830eea6" ;;
  darwin_arm64) checksum="ad789987a97b47ab55207c25bcd2895d7c007eb6a6a75d611ecc414bd323bbae" ;;
  linux_amd64) checksum="eb2901d70c05915fb8f6a51a77fcdd266db716e3a666ccd7c2921c78814ded5f" ;;
  linux_arm64) checksum="fc3c35556f78a664badb4184f47fbb73801c1ec83f116baaba52503fe91aaeb9" ;;
esac

cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/home-server-configuration/kopiur/${version}"
binary="${cache_root}/kopiur"

if [[ ! -x "${binary}" ]]; then
  archive="${cache_root}/kubectl-kopiur_${version}_${os}_${arch}.tar.gz"
  mkdir -p "${cache_root}"
  curl --fail --location --silent --show-error \
    "https://github.com/home-operations/kopiur/releases/download/${version}/$(basename "${archive}")" \
    --output "${archive}"

  if command -v sha256sum >/dev/null 2>&1; then
    actual_checksum="$(sha256sum "${archive}" | cut -d ' ' -f 1)"
  else
    actual_checksum="$(shasum -a 256 "${archive}" | cut -d ' ' -f 1)"
  fi
  [[ "${actual_checksum}" == "${checksum}" ]]

  tar -xzf "${archive}" -C "${cache_root}" kopiur
  chmod +x "${binary}"
fi

exec "${binary}" "$@"
